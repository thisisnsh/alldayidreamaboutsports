# Staging-only credentials for tester/ scripts. Copy to .staging.env and fill in.
# Pull values from GCP Secret Manager / the Cloudflare R2 dashboard for STAGING.
# Never put production values here — the publisher refuses any bucket without "staging".
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_SCORES=
SCORES_DOMAIN=https://
