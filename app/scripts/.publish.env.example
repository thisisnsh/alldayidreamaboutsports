# R2 credentials for app publishing. Copy to .publish.env and fill in.
# Keep this file local; it can publish to staging or production depending on
# the publish.sh channel.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
