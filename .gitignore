# macOS
.DS_Store

# Xcode
app/*.xcodeproj
app/build/
DerivedData/
*.xcresult
xcuserdata/

# Environment-specific service configuration — never commit
app/Resources/GoogleService-Info-*.plist
*.p12
*.p8
.env
.env.*
!.env.example
!.env.push.example

# Node
node_modules/
dist/
*.tsbuildinfo

# tester/ staging-only secrets (never commit real staging creds)
tester/.staging.env

# Python infrastructure checks
__pycache__/
*.pyc

# Local-only tool state and retired publish credentials (keep old files ignored)
.wrangler/
app/scripts/.publish.env

# Device push endpoint overrides; signing keys must never enter the repository.
app/iOS/Push.local.xcconfig
backend/secrets/*
!backend/secrets/*.example
