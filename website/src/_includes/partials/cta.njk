<section class="cta" aria-labelledby="cta-h">
  <div class="wrap wrap-narrow">
    {% set ctaH = ctaHeading or "Don't just watch it.<br /><em>Live it.</em>" %}
    <h2 class="display reveal" id="cta-h">{{ ctaH | safe }}</h2>
    <p class="body reveal d1">{{ ctaBody or "Follow your teams, catch every moment, and celebrate together. Free for macOS - iPhone, iPad and Windows coming soon." }}</p>
    <div class="actions reveal d2">
      <a class="btn btn-primary" href="{{ site.downloadUrl }}"><span class="apple" aria-hidden="true"></span>Download on the App Store</a>
      <a class="btn btn-ghost" href="/#demo">Watch the demo</a>
    </div>
    <span class="meta-note reveal d2">On the Mac App Store · Free · {{ site.requiresShort }}</span>
  </div>
</section>
