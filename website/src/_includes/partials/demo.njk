<section class="demo" id="demo" aria-labelledby="demo-h">
  <div class="wrap">
    <p class="micro">See it in action</p>
    <h2 class="section-h" id="demo-h">Keep working. Keep the match close.</h2>
    <p class="body demo-intro">Watch the demo to see match alerts, pinned scores and goal celebrations on your Mac.</p>
    <div class="demo-player">
      <iframe src="{{ site.youtube.embed }}" title="{{ site.name }} - demo"
              width="960" height="540" loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>
    </div>
    <p class="demo-caption"><a href="{{ site.youtube.watch }}" target="_blank" rel="noopener">Watch on YouTube ↗</a></p>
  </div>
</section>
