{#
  The reel, as a fixed layer the whole page scrolls over.

  Order matters. The poster is a plain <img> so it paints with the first paint
  and is the LCP element - the background is the video's own first frame from
  the very start, never black. The <video> carries no source at all until
  script.js decides this visitor should get one, and stays transparent until it
  can play, so the crossfade has nothing to reveal.
#}
<div class="videobg" aria-hidden="true">
  <img class="videobg-poster" src="{{ site.video.poster }}" alt=""
       width="1664" height="1080" fetchpriority="high" decoding="async" />
  <video class="videobg-media" id="bgvideo" muted playsinline loop
         preload="none" tabindex="-1"
         data-mp4="{{ site.video.mp4 }}" data-webm="{{ site.video.webm }}"></video>
  <div class="videobg-scrim"></div>
</div>
<div class="bufferbar" id="bufferbar" hidden><i></i></div>
