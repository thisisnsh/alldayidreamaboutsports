---
layout: layouts/base.njk
---
{% set clubs = teams | where("leagueId", league.id) %}
{% set others = leagues | reject("id", league.id) %}

{% set heroMicro = league.country + " · " + league.season + (" season" if league.type != "Cup" else "") %}
{% set heroCrest = league.crest %}
{% set heroTitle = league.name + " match alerts on your Mac - <em>free</em>" %}
{% set heroBody = extras.heroSub %}
{% include "partials/hero.njk" %}

<section class="prose-sec solid">
  <div class="wrap wrap-narrow">
    <p class="micro">Following the {{ league.name }}</p>
    <h2 class="section-h">{{ introHeading }}</h2>
    <p class="body">{{ extras.intro1 }}</p>
    <p class="body">{{ extras.intro2 }}</p>
  </div>
</section>

{% set featuresHeading = "What following the " + league.name + " looks like" %}
{% set featuresMicro = "What you get" %}
{% set featuresId = "features" %}
{% set featureRows = features.forLeague(league) %}
{% include "partials/features.njk" %}

{% set gridTeams = clubs %}
{% set gridId = "clubs" %}
{% set gridSolid = true %}
{% set gridMicro = "Teams and leagues" %}
{% set gridHeading = "Follow teams or leagues" %}
{% set gridNote = "Choose a team below, or follow the entire " + league.name + " in the app." %}
{% include "partials/team-grid.njk" %}

<section class="strip">
  <div class="wrap">
    <p class="micro">The other competitions</p>
    <h2 class="section-h">Follow more than one</h2>
    <ul class="leaguerows">
      {% for l in others %}
      <li class="leaguerow reveal">
        <a href="/{{ l.slug }}/">
          <img src="{{ l.crest }}" alt="" width="34" height="34" loading="lazy" decoding="async" />
          <span class="lr-name">{{ l.name }} match alerts</span>
          <span class="lr-meta">{{ l.country }}</span>
          <span class="lr-state{% if l.active %} is-live{% endif %}">{% if l.active %}In season{% else %}2026 recap{% endif %}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% set faqHeading = league.name + " on macOS, answered" %}
{% include "partials/faq.njk" %}

{% set ctaHeading = "Follow the " + league.name + ".<br />Keep working." %}
{% set ctaBody = "Free on macOS 14 and later. Sign in, choose what you follow, and keep the match close while you work." %}
{% include "partials/cta.njk" %}
