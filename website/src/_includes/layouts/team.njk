---
layout: layouts/base.njk
---
{% set heroMicro = (team.leagueName + " · " + team.country) if not team.national else ("World Cup 2026 · " + team.country) %}
{% set heroCrest = team.crest %}
{% set heroTitle = "Follow " + team.displayName + " on Mac - <em>free</em> match alerts" %}
{% set heroBody = heroSub %}
{% include "partials/hero.njk" %}

<section class="prose-sec solid">
  <div class="wrap wrap-narrow">
    <p class="micro">{{ extras.nickname | default("The club", true) }}</p>
    <h2 class="section-h">{{ introHeading }}</h2>
    <p class="body">{{ extras.blurb }}</p>
    <p class="body">{{ introSecond }}</p>
  </div>
</section>

{% set featuresHeading = "What you get following " + team.displayName %}
{% set featuresMicro = "Following " + team.displayName %}
{% set featuresId = "features" %}
{% set featureRows = features.forTeam(team) %}
{% include "partials/features.njk" %}

{% if relatedTeams | length %}
{% set gridTeams = relatedTeams %}
{% set gridId = "related" %}
{% set gridSolid = true %}
{% set gridMicro = "More to follow" %}
{% set gridHeading = "Teams you might also follow" %}
{% set gridNote = "A few more clubs from the same competition to keep close." %}
{% include "partials/team-grid.njk" %}
{% endif %}

{% if siblings | length %}
{% set gridTeams = siblings %}
{% set gridId = "more" %}
{% set gridSolid = false %}
{% set gridMicro = "More from the " + league.name %}
{% set gridHeading = siblingHeading %}
{% set gridNote = false %}
{% include "partials/team-grid.njk" %}
{% endif %}

{% if clubLeague %}
{% set gridTeams = countryClubs %}
{% set gridId = "clubs" %}
{% set gridSolid = true %}
{% set gridMicro = "Club football in " + team.country %}
{% set gridHeading = "Playing every week: the " + clubLeague.name %}
{% set gridNote = "There are no " + team.displayName + " fixtures to alert on between tournaments, but the " + clubLeague.name + " runs all season and the app covers every match of it." %}
{% include "partials/team-grid.njk" %}
<p class="backline"><a href="/{{ clubLeague.slug }}/">Follow the {{ clubLeague.name }} →</a></p>
{% endif %}

<p class="backline"><a href="/{{ league.slug }}/">Follow the {{ league.name }} →</a></p>

{% set faqHeading = team.displayName + " on macOS, answered" %}
{% include "partials/faq.njk" %}

{% set ctaHeading = "Follow " + team.displayName + ".<br />Keep working." %}
{% set ctaBody = "Free on macOS 14 and later. Sign in, choose what you follow, and keep the match close while you work." %}
{% include "partials/cta.njk" %}
