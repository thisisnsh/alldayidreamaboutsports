# Copy to .env (ignored). Build/tests do not require these credentials.
# This is a configuration template, not a runnable deployment.
GCP_PROJECT_ID=your-firebase-project
SERVICE_URL=https://your-isolated-push-service.run.app
SCORES_ORIGIN=https://scores.alldayidreamaboutsports.com
TASKS_LOCATION=us-central1
TASKS_QUEUE=sports-push
INVOKER_EMAIL=sports-push-invoker@your-firebase-project.iam.gserviceaccount.com
FIRESTORE_DATABASE=sports-push
FIREBASE_APP_IDS=1:YOUR_PROJECT_NUMBER:ios:YOUR_APP_ID
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_ID=XXXXXXXXXX
# Keep PEM contents in Secret Manager for deployment. Never put them in a build arg or image.
APNS_PRIVATE_KEY=REPLACE_THIS_WITH_THE_CONTENTS_OF_YOUR_APPLE_APNS_SIGNING_KEY
APNS_BUNDLE_ID=com.thisisnsh.alldaysports
APNS_ENVIRONMENT=sandbox
DRY_RUN=true
POLL_SECONDS=5
PORT=8080
